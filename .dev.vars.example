# Copy to .dev.vars for `pnpm dev:worker` (wrangler dev; runs the Worker and Durable Objects locally, no Docker needed).
# Never commit .dev.vars or real values.
DASHBOARD_ADMIN_PASSCODE=replace-with-a-long-admin-passcode
DASHBOARD_SESSION_SECRET=replace-with-64-hex-random-key
TENANT_CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-random-key
APP_PUBLIC_URL=http://localhost:8787

# Optional: override the Gemini Live model or voice (see docs/provider-references.md).
# GEMINI_LIVE_MODEL=models/gemini-3.8-live
# GEMINI_VOICE_NAME=Charon
