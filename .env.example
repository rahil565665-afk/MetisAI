# Local development only (`pnpm dev`). Copy to .env; never commit or upload .env.
# Production runs on Cloudflare Workers, where every value below is a Worker *Secret*
# (see docs/deploy-cloudflare.md). `pnpm dev:worker` reads .dev.vars instead (see .dev.vars.example).

# Admin console sign-in. 8-128 characters; use a long random passphrase.
DASHBOARD_ADMIN_PASSCODE=

# Signs admin sessions and derives each clinic's voice/bridge keys. 32 random bytes as 64 hex characters:
#   openssl rand -hex 32
# (Optional only in local development; the server refuses to start without it in production.)
DASHBOARD_SESSION_SECRET=

# Encrypts clinic provider keys (Gemini, Cartesia, Cal.com, Twilio) before they are stored. Generate with:
#   openssl rand -hex 32
# Back this value up: if it is lost, the saved clinic keys cannot be decrypted and must be re-entered.
TENANT_CREDENTIALS_ENCRYPTION_KEY=

# Exact public origin of the console, no path. Must be HTTPS except for localhost.
APP_PUBLIC_URL=http://localhost:3000

# Central Supabase project. The secret (service-role) key is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local API/web ports for `pnpm dev`.
API_PORT=3001
PORT=3000
