# Local agent development only. In production the console injects these per clinic; never commit .env.
TENANT_ID=00000000-0000-0000-0000-000000000000
# 64 hex characters; must equal the key the console derives for this tenant (HKDF of DASHBOARD_SESSION_SECRET).
VOICE_TOKEN_SIGNING_SECRET=
# Console origin the agent calls back to and the browser Origin it accepts.
DASHBOARD_ORIGIN=http://localhost:8787
GEMINI_API_KEY=
# Only when the clinic uses Cartesia speech output / Cal.com scheduling.
CARTESIA_API_KEY=
CALCOM_API_KEY=
PORT=10000
